# Custom health check message
PING_MESSAGE=pong

# Production database (Dokploy/Turso)
# DATABASE_URL=libsql://<database-name>-<organization>.turso.io
# DATABASE_AUTH_TOKEN=<turso-auth-token>

# Production auth/session secret
# BETTER_AUTH_SECRET=<generate-a-long-random-secret>
# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true
